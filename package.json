{
  "name": "magpie-cursor-private",
  "version": "1.0.1",
  "type": "module",
  "description": "A local Magpie agent bridge for Cursor with authenticated loopback endpoints and in-memory sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuyudarenC/magpie-cursor-bridge.git"
  },
  "magpie": {
    "agent": "./src/agent.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "privacy": "node scripts/privacy-check.mjs",
    "build:native": "bash scripts/build.sh",
    "setup": "bash scripts/setup.sh",
    "status": "node scripts/manage.js status"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "src",
    "scripts",
    "native",
    "licenses",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "bin/cursor-private-engine",
    "integrity.json"
  ]
}
