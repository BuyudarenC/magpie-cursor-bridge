{
  "name": "magpie-cursor-private",
  "version": "1.0.0",
  "type": "module",
  "description": "A local Magpie agent bridge for Cursor with authenticated loopback endpoints and in-memory sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuyudarenC/magpie-cursor-bridge.git"
  },
  "magpie": {
    "agent": "./agent.js"
  },
  "scripts": {
    "test": "node --test security.test.js",
    "privacy": "node privacy-check.mjs",
    "build:native": "bash build.sh"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "files": [
    "agent.js",
    "service.js",
    "manage.js",
    "settings.js",
    "config.js",
    "build.sh",
    "setup.sh",
    "native.patch",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "reference-LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "bin/cursor-private-engine",
    "integrity.json"
  ]
